# ==============================================================================
# STUDY BLUEPRINT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Python FastAPI)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/study_blueprint?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/study_blueprint
MONGODB_DATABASE_NAME=study_blueprint

# Google Identity Services / OAuth 2.0 Client ID
# Retrieve from Google Cloud Console -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend Application Session Secret (Random 32+ character hex string for signing session JWTs)
APP_SESSION_SECRET=change-this-to-a-super-secret-random-32-char-key-in-production

# Environment Mode: 'development' | 'production' | 'test'
ENVIRONMENT=development

# Allowed CORS Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# File Storage Provider ('local' | 's3')
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_DIR=./storage/uploads

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js App Router)
# ------------------------------------------------------------------------------
# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend Google Client ID (Publicly exposed to GIS browser library)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
